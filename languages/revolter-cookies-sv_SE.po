msgstr "Läs vår cookiepolicy"

#: includes/class-texts.php:27
msgid "Accept all"
msgstr "Godkänn alla"

#: includes/class-texts.php:28
msgid "Reject all"
msgstr "Neka alla"

#: includes/class-texts.php:29
msgid "Customise"
msgstr "Anpassa"

#: includes/class-texts.php:30
msgid "Save choices"
msgstr "Spara val"

#: includes/class-texts.php:31
