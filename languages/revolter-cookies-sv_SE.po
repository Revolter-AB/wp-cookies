msgstr "Stäng"

#: includes/class-texts.php:32
#: includes/class-texts.php:35
msgid "Cookie settings"
msgstr "Cookieinställningar"

#: includes/class-texts.php:33
msgid "Made with care by"
msgstr "Skapad med omsorg av"

#: includes/class-texts.php:34
msgid "Always on"
msgstr "Alltid på"

#: includes/class-texts.php:36
msgid "Choose which types of cookies you accept. Necessary cookies cannot be switched off because the website does not work without them."
msgstr "Välj vilka typer av cookies du godkänner. Nödvändiga cookies kan inte stängas av eftersom webbplatsen inte fungerar utan dem."

#: includes/class-texts.php:49
msgid "Necessary"
msgstr "Nödvändiga"

#: includes/class-texts.php:51
msgid "Preferences"
msgstr "Inställningar"

#: includes/class-texts.php:53
msgid "Statistics"
msgstr "Statistik"

#: includes/class-texts.php:55
msgid "Marketing"
msgstr "Marknadsföring"

#: includes/class-texts.php:57
msgid "Unclassified"
msgstr "Oklassificerade"

#: includes/class-texts.php:70
msgid "Required for basic functions such as security and remembering your cookie choice."
msgstr "Krävs för grundläggande funktioner som säkerhet och att spara ditt cookieval."

#: includes/class-texts.php:72
msgid "Remember your choices, such as language."
msgstr "Kommer ihåg dina val, till exempel språk."

#: includes/class-texts.php:74
msgid "Help us understand how the website is used, through anonymised statistics."
msgstr "Hjälper oss förstå hur webbplatsen används, via anonymiserad statistik."

#: includes/class-texts.php:76
msgid "Used to show relevant ads and embedded content such as YouTube."
msgstr "Används för att visa relevanta annonser och inbäddat innehåll som YouTube."

#: includes/class-texts.php:78
msgid "Cookies that have not yet been classified."
msgstr "Cookies som ännu inte har klassificerats."

